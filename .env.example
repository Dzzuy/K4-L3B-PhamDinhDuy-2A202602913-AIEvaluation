# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env and replace only the API-key placeholder.
# The OpenAI Python SDK is only the transport client for OpenRouter's API.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional OpenRouter attribution. These values are not credentials.
OPENROUTER_HTTP_REFERER=https://github.com/Dzzuy/K4-L3B-PhamDinhDuy-2A202602913-AIEvaluation
OPENROUTER_APP_TITLE=OrbitTech AI Evaluation Lab
